<adapter-config xsdTargetNamespace="http://xmlns.oracle.com/cloud/adapter/bbtranslationadapter/translate_REQUEST/types" name="translate_REQUESTPortType" adapter="bbtranslationadapter" wsdlLocation="translate_REQUEST.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
  <connection-factory location="cloud/CloudAdapter">
    <non-managed-connection managedConnectionFactoryClassName="oracle.cloud.connector.b2b.RestAdapterConnectionFactory">
      <property name="applicationVersion" value="1.0"/>
      <property name="securityPolicy" value="NONE"/>
    </non-managed-connection>
  </connection-factory>
  <endpoint-interaction portType="translate_REQUESTPortType" operation="execute">
    <interaction-spec className="oracle.tip.adapter.cloud.CloudInteractionSpec">
      <property name="targetOperation" value="execute"/>
      <property name="enforceResponseSizeRestriction" value="true"/>
      <property name="oic.gen3.invoke" value="true"/>
      <property name="HTTPHeadersAdded" value="true"/>
      <property name="HttpVerb" value="POST"/>
      <property name="RequestElementNS" value="http://xmlns.oracle.com/b2b/edi/generic/fetch_message"/>
      <property name="RequestElementName" value="FetchMessageInput"/>
      <property name="RequestMediaType" value="application/xml"/>
      <property name="ResponseElementNS" value="http://xmlns.oracle.com/b2b/EDIFACT/D00A/transactionset-APERAK/TEST_DOC"/>
      <property name="ResponseElementName" value="FetchMessageOutput"/>
      <property name="ResponseMediaType" value="application/xml"/>
      <property name="b2b_translate_direction" value="b2b_translate_inbound"/>
      <property name="b2b_translate_doc_def" value="TEST_DOC"/>
      <property name="b2b_translate_doc_type" value="APERAK"/>
      <property name="b2b_translate_doc_type_label" value="APERAK (Application error and acknowledgement message)"/>
      <property name="b2b_translate_doc_version" value="D00A"/>
      <property name="b2b_translate_mode" value="b2b_translate_mode_tp"/>
      <property name="b2b_translate_standard" value="EDIFACT"/>
      <property name="b2b_translate_standard_label" value="EDIFACT"/>
      <property name="b2b_translate_tp_operation" value="b2b_translate_tp_operation_fetch_message"/>
      <property name="b2b_translate_tp_operation_name" value="Fetch Message"/>
      <property name="generatePartnerLink" value="false"/>
      <property name="isCollocated" value="true"/>
    </interaction-spec>
  </endpoint-interaction>
</adapter-config>